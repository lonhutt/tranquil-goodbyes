---
import Base from "../layouts/Base.astro";
import { site } from "../site";
---

<Base
    title="Contact"
    description="Text, call, or email Tranquil Goodbyes to request an in-home visit."
>
    <div class="page-head">
        <div class="eyebrow">Contact</div>
        <h1>When you're ready, we're here.</h1>
        <p>
            Text, call, or email to schedule. Texting is the fastest way to get
            a response.
        </p>
    </div>
    <section class="split" style="align-items:start">
        <div class="card contact-card">
            <h3>Text or call</h3>
            <a class="big" href={site.smsHref}>
                {site.phone}
            </a>
            <div class="btns">
                <a class="btn" href={site.smsHref}>
                    Send a text
                </a>
                <a class="btn ghost" href={site.phoneHref}>
                    Call
                </a>
            </div>
            <h3 style="margin-top:12px">Email</h3>
            <a class="big" style="font-size:24px" href={`mailto:${site.email}`}>
                {site.email}
            </a>
            <a
                class="btn"
                style="margin-top:12px"
                href={`mailto:${site.email}?subject=Visit%20request`}
            >
                Request a visit
            </a>
        </div>
        <div class="prose">
            <h2 style="color:var(--ink)">It helps to know</h2>
            <ul>
                <li>Your name</li>
                <li>The best way to reach you</li>
                <li>Your pet's name</li>
                <li>Your pet's breed and age</li>
                <li>Your town</li>
                <li>Why it's time to say goodbye</li>
            </ul>
            <p>That's all we need to start.</p>
            <p>Serving Lone Tree and the greater Denver area.</p>
        </div>
    </section>
</Base>
